<Window x:Class="Orbit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Orbit.Views"
        Title="Orbit" Width="1240" Height="780" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Icon="Assets/orbit.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border x:Name="SidebarRoot" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Border Background="{StaticResource GlowBottomLeft}" IsHitTestVisible="False"/>
                <DockPanel Margin="14,16,14,14">

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                        <Image Source="Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold">
                                <Run Text="Orbit"/><Run Text=".Beta" Foreground="{StaticResource SignalBrush}"/>
                            </TextBlock>
                            <TextBlock Text="by ph1l59" Style="{StaticResource Crumb}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBox x:Name="SearchBox" Tag="Search" Padding="10,0,34,0"
                                 TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,12,0"
                                   HorizontalAlignment="Right" Foreground="{StaticResource FaintBrush}" IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Bottom: multi-roblox + about -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="12,10" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="MultiPill_Click"
                                ToolTip="Allow several Roblox windows at once (Bootstrapper)">
                            <DockPanel>
                                <Ellipse x:Name="MultiDot" Width="8" Height="8" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center"/>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Multi-Roblox" FontWeight="SemiBold" FontSize="12.5"/>
                                    <TextBlock x:Name="MultiText" Text="Off" Style="{StaticResource Crumb}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ListBox x:Name="BottomNav" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource NavItem}"
                                 SelectionChanged="BottomNav_SelectionChanged">
                            <ListBoxItem Tag="about">
                                <DockPanel>
                                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="v2.0.0" Style="{StaticResource Crumb}" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Width="22"/>
                                    <TextBlock Text="About" Margin="8,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                                </DockPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>

                    <Grid>
                        <!-- Navigation -->
                        <ListBox x:Name="Nav" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource NavItem}"
                                 SelectionChanged="Nav_SelectionChanged"/>

                        <!-- Search results -->
                        <StackPanel x:Name="SearchPanel" Visibility="Collapsed">
                            <TextBlock x:Name="SearchCount" Style="{StaticResource Crumb}" Margin="12,0,0,8"/>
                            <ListBox x:Name="SearchResults" Style="{StaticResource BareList}" ItemContainerStyle="{StaticResource NavItem}"
                                     SelectionChanged="SearchResults_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Crumb}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ================= Content ================= -->
        <Grid x:Name="ContentRoot" Grid.Column="1">
            <Border Background="{StaticResource DotGridBrush}" IsHitTestVisible="False"/>
            <Border Background="{StaticResource GlowTopRight}" IsHitTestVisible="False"/>
            <Border Background="{StaticResource GlowCenter}" IsHitTestVisible="False"/>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximize"/>
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>

                <ContentControl x:Name="ContentHost" Grid.Row="1" Margin="40,0,40,26" Focusable="False"/>
            </Grid>

        </Grid>

        <!-- Update notice: slides in from the left edge of the window when a new release is out -->
        <Border x:Name="UpdateCard" Grid.ColumnSpan="2" Panel.ZIndex="100" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12,0,0,12" Width="330"
                Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource SignalBorderBrush}" BorderThickness="1"
                CornerRadius="12" Padding="18,14,18,16" Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.55"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="UpdateCardShift"/>
            </Border.RenderTransform>
            <StackPanel>
                <DockPanel>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SignalBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#A855F7" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="UPDATE AVAILABLE" Style="{StaticResource Crumb}" Foreground="{StaticResource SignalLightBrush}"/>
                </DockPanel>
                <TextBlock x:Name="UpdateTitle" Text="Orbit v0.0.0" FontFamily="{StaticResource DisplayFont}" FontSize="19"
                           FontWeight="Bold" Margin="0,6,0,0"/>
                <TextBlock x:Name="UpdateText" Style="{StaticResource RowDesc}" Text="A new version of Orbit is ready."/>
                <ProgressBar x:Name="UpdateProgress" Maximum="100" Margin="0,12,0,0" Visibility="Collapsed"/>
                <StackPanel x:Name="UpdateButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="UpdateLaterButton" Content="Not Now" Click="UpdateLater_Click"/>
                    <Button x:Name="UpdateNowButton" Content="Update Now" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Click="UpdateNow_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Friends drawer: slides in from the right over the whole window ================= -->
        <Grid x:Name="DrawerLayer" Grid.ColumnSpan="2" Panel.ZIndex="200" Visibility="Collapsed"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="DrawerShade" Background="#73000000" MouseLeftButtonDown="DrawerShade_Click"/>
            <views:FriendsDrawer x:Name="Friends" HorizontalAlignment="Right" Width="390">
                <views:FriendsDrawer.RenderTransform>
                    <TranslateTransform x:Name="DrawerShift" X="420"/>
                </views:FriendsDrawer.RenderTransform>
            </views:FriendsDrawer>
        </Grid>
    </Grid>
</Window>
