<UserControl x:Class="Orbit.Views.FlagEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0" Height="24" Click="Back_Click">
                <TextBlock Style="{StaticResource Crumb}" Text="← ORBIT / FASTFLAGS / EDITOR"/>
            </Button>
            <TextBlock Style="{StaticResource PageTitle}">
                <Run Text="Fast Flag"/> <Run Text="editor" Foreground="{StaticResource AccentTextBrush}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource PageDesc}" Text="Your own flags. They override the presets. Only flags on Roblox's allowlist have an effect."/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Click="Add_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/>
                    <TextBlock Text="Add flag" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Content="Import JSON" Margin="8,0,0,0" Click="Import_Click"/>
            <Button DockPanel.Dock="Left" Content="Copy as JSON" Margin="8,0,0,0" Click="Export_Click"/>
            <TextBlock x:Name="CountText" Style="{StaticResource Crumb}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="18,12,18,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="NAME" Style="{StaticResource Crumb}"/>
                    <TextBlock Grid.Column="2" Text="VALUE" Style="{StaticResource Crumb}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="Rows" Margin="12,0,12,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                                 Tag="FIntExampleFlag"/>
                                        <TextBox Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="{StaticResource MonoFont}" Tag="value"/>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Width="34" Padding="0" HorizontalAlignment="Right"
                                                Click="Delete_Click" ToolTip="Remove">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Style="{StaticResource RowDesc}" Margin="18,4,18,20"
                                   Text="No custom flags yet. Click “Add flag” or import a JSON object."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SolidButton}" Content="Save flags" MinWidth="130" Click="Save_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource RowDesc}" Margin="0,0,16,0" VerticalAlignment="Center"
                           Text="Values are written exactly as entered (e.g. True, False, 0, 120)."/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
