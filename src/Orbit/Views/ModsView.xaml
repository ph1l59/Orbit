<UserControl x:Class="Orbit.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="ORBIT / 04 / MODS" Style="{StaticResource Crumb}"/>
            <TextBlock Style="{StaticResource PageTitle}">
                <Run Text="Client"/> <Run Text="mods" Foreground="{StaticResource AccentTextBrush}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource PageDesc}" Text="Manage and apply file mods to the Roblox client. Original files are backed up and restored when you remove a mod."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource LinkRow}" Click="OpenFolder_Click" Tag="Open Mods Folder|custom files modifications">
                        <DockPanel>
                            <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,16,0" Foreground="{StaticResource SignalLightBrush}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Open Mods Folder"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="Manage custom Roblox mods here."/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource LinkRow}" Click="Help_Click" Tag="Mods help|how to create mods">
                        <DockPanel>
                            <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,16,0" Foreground="{StaticResource SignalLightBrush}"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowTitle}" Text="Help"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="How mods work and how to make your own."/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </Grid>

                <Button Style="{StaticResource LinkRow}" Click="Compat_Click" Tag="Manage compatibility settings|dpi scaling fullscreen optimizations">
                    <DockPanel>
                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,16,0" Foreground="{StaticResource SignalLightBrush}"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="Manage compatibility settings"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Windows settings for the Roblox app such as DPI scaling and fullscreen optimizations."/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <StackPanel x:Name="CompatPanel" Visibility="Collapsed" Margin="24,0,0,0">
                    <Border Style="{StaticResource Row}" Tag="Override high DPI scaling|compatibility">
                        <DockPanel>
                            <CheckBox x:Name="DpiToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Override high DPI scaling"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="Lets Roblox handle scaling itself instead of Windows stretching it."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}" Tag="Disable fullscreen optimizations|compatibility">
                        <DockPanel>
                            <CheckBox x:Name="FsoToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                            <StackPanel Style="{StaticResource RowText}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="Disable fullscreen optimizations"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="Can reduce input lag and stutter in fullscreen on some PCs."/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="// PRESETS" Style="{StaticResource Section}"/>

                <Border Style="{StaticResource Row}" Tag="Mouse cursor|custom cursor image">
                    <DockPanel>
                        <CheckBox x:Name="CursorToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed" Margin="12,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="Choose image…" Click="ChooseCursor_Click" VerticalAlignment="Center"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Mouse cursor"/>
                            <TextBlock x:Name="CursorText" Style="{StaticResource RowDesc}" Text="Use your own PNG as the in-game cursor (about 64×64 px works best)."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="// MISCELLANEOUS" Style="{StaticResource Section}"/>

                <Border Style="{StaticResource Row}" Tag="Use custom font|font ttf otf">
                    <DockPanel>
                        <Button x:Name="RemoveFontButton" DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                                Click="RemoveFont_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                <TextBlock Text="Remove applied font" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Content="Choose font…" Click="ChooseFont_Click" VerticalAlignment="Center"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Use custom font"/>
                            <TextBlock x:Name="FontText" Style="{StaticResource RowDesc}" Text="Replace every font in Roblox with a .ttf or .otf file of your choice."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SolidButton}" Content="Apply mods now" MinWidth="150" Click="Apply_Click"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource RowDesc}" Margin="0,0,16,0" VerticalAlignment="Center"
                           Text="Mods are applied automatically every time Orbit launches Roblox."/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
