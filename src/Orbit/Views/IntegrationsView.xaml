<UserControl x:Class="Orbit.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="ORBIT / 06 / INTEGRATIONS" Style="{StaticResource Crumb}"/>
            <TextBlock Style="{StaticResource PageTitle}">
                <Run Text="Integra"/><Run Text="tions" Foreground="{StaticResource AccentTextBrush}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource PageDesc}" Text="Configure additional functionality to go alongside Roblox."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Text="// ACTIVITY TRACKING" Style="{StaticResource Section}" Margin="2,14,0,10"/>

                <Border Style="{StaticResource Row}" Tag="Enable activity tracking|detect game">
                    <DockPanel>
                        <CheckBox x:Name="TrackingToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Enable activity tracking"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Lets Orbit detect which Roblox game you're playing (from Roblox's own log files). Some features below need this."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Query server details|server location region">
                    <DockPanel>
                        <CheckBox x:Name="LocationToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Query server details"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="When you join a server, a notification shows where it's located (looked up via ipinfo.io)."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="// DISCORD RICH PRESENCE" Style="{StaticResource Section}"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="2,-4,0,10"
                           Text="Needs activity tracking and the Discord desktop app running."/>

                <Border Style="{StaticResource Row}" Tag="Show game activity|discord rich presence">
                    <DockPanel>
                        <CheckBox x:Name="DiscordToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Show game activity"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="The Roblox game you're playing is shown on your Discord profile."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Discord application ID|discord app id client id">
                    <DockPanel>
                        <TextBox x:Name="AppIdBox" DockPanel.Dock="Right" Width="220" FontFamily="{StaticResource MonoFont}"
                                 Tag="Application ID" LostKeyboardFocus="AppId_LostFocus"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Discord application ID"/>
                            <TextBlock Style="{StaticResource RowDesc}">
                                <Run Text="The name Discord shows (“Playing …”) comes from a Discord app. Create one for free in the"/>
                                <Hyperlink Click="DevPortal_Click" Foreground="{StaticResource SignalLightBrush}">Developer Portal</Hyperlink>
                                <Run Text=", name it e.g. “Roblox” and paste its Application ID here."/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Discord status display|name state details">
                    <DockPanel>
                        <ComboBox x:Name="StatusCombo" DockPanel.Dock="Right" SelectionChanged="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Discord status display"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="What appears next to your name in the member list."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Allow activity joining|join button discord">
                    <DockPanel>
                        <CheckBox x:Name="JoinToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Allow activity joining"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Adds a “Join server” button to your Discord profile, so anybody can join the game you're in."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Show Roblox account|discord avatar">
                    <DockPanel>
                        <CheckBox x:Name="AccountToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Show Roblox account"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Shows the account you're playing with (the one Orbit launched last) on your Discord profile."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="// CUSTOM INTEGRATIONS" Style="{StaticResource Section}"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="2,-4,0,10"
                           Text="Programs that start automatically when Orbit launches Roblox – e.g. an FPS overlay or a macro tool."/>

                <ItemsControl x:Name="CustomList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Row}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="34" Padding="0" Margin="10,0,0,0"
                                            Click="RemoveCustom_Click" ToolTip="Remove">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12"/>
                                    </Button>
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding CloseWithRoblox}"
                                              Click="CustomChanged" ToolTip="Close it when Roblox closes"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Crumb}" Text="CLOSE WITH ROBLOX" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Style="{StaticResource RowText}">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource Crumb}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" Margin="0,3,0,6"/>
                                        <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Tag="Launch arguments (optional)"
                                                 LostKeyboardFocus="CustomChanged" MaxWidth="420" HorizontalAlignment="Left" MinWidth="260"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="AddCustom_Click"
                        Tag="Add custom integration|program launch with roblox">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/>
                        <TextBlock Text="Add program" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
