<Window x:Class="Orbit.Views.CreateAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit – Create Roblox accounts" Width="560" Height="780" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="/Assets/orbit.ico">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="ORBIT // CREATE ACCOUNTS" Style="{StaticResource Crumb}" Foreground="{StaticResource SignalLightBrush}"/>
                <TextBlock Text="Create Roblox accounts" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock Style="{StaticResource RowDesc}" Margin="0,4,0,0"
                           Text="Pick the birthday and gender once, then list your accounts. Orbit opens Roblox's sign-up page for each one and fills it in – you click Sign Up and solve any check yourself."/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="18,12">
            <DockPanel>
                <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        Click="Start_Click" IsDefault="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="11"/>
                        <TextBlock x:Name="StartText" Text="Start" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CheckButton" DockPanel.Dock="Right" Content="Check names" Margin="8,0,0,0" Click="Check_Click"/>
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True"/>
                <TextBlock x:Name="FooterText" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Margin="18,16,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Birthday -->
            <StackPanel>
                <TextBlock Text="BIRTHDAY" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="DayBox" MinWidth="0" Width="84" SelectionChanged="Details_Changed"/>
                    <ComboBox x:Name="MonthBox" MinWidth="0" Width="150" Margin="8,0,0,0" SelectionChanged="Details_Changed"/>
                    <ComboBox x:Name="YearBox" MinWidth="0" Width="100" Margin="8,0,0,0" SelectionChanged="Details_Changed"/>
                </StackPanel>
            </StackPanel>

            <!-- Gender -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Text="GENDER" Style="{StaticResource Label}"/>
                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="3" HorizontalAlignment="Left" Width="342">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="GenderMale" Style="{StaticResource Segment}" Content="Male" GroupName="Gender"/>
                        <RadioButton x:Name="GenderFemale" Style="{StaticResource Segment}" Content="Female" GroupName="Gender"/>
                        <RadioButton x:Name="GenderNone" Style="{StaticResource Segment}" Content="Don't set" GroupName="Gender"/>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <!-- List -->
            <DockPanel Grid.Row="2" Margin="0,18,0,6">
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Style="{StaticResource Label}" Margin="0"/>
                <TextBlock Text="ACCOUNTS  ·  ONE PER LINE  ·  USERNAME:PASSWORD" Style="{StaticResource Label}" Margin="0"/>
            </DockPanel>
            <TextBox x:Name="AccountsBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" Padding="10,8" FontFamily="{StaticResource MonoFont}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Tag="MyAccount1:a-long-password" TextChanged="List_TextChanged"/>

            <!-- Per-line results -->
            <Border Grid.Row="4" Margin="0,10,0,0" MaxHeight="190" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RowsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Foreground="{Binding Brush}"
                                               FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Width="20"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Width="170" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Brush}" FontSize="12"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
