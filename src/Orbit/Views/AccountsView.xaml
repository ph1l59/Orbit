<UserControl x:Class="Orbit.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Orbit.Views">

    <UserControl.Resources>
        <local:UrlToImageConverter x:Key="UrlToImage"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>


        <Style x:Key="AccountItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="Item_RightButtonDown"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <!-- Drag handle on the left edge of the card -->
                                <Border x:Name="grip" Width="24" HorizontalAlignment="Left" Background="Transparent" Cursor="Hand"
                                        CornerRadius="10,0,0,10" ToolTip="Drag to reorder"
                                        PreviewMouseLeftButtonDown="Grip_MouseDown" MouseMove="Grip_MouseMove"
                                        PreviewMouseLeftButtonUp="Grip_MouseUp" LostMouseCapture="Grip_LostCapture">
                                    <UniformGrid x:Name="dots" Columns="2" Rows="3" Width="8" Height="13" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource FaintBrush}"/>
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource FaintBrush}"/>
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource FaintBrush}"/>
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource FaintBrush}"/>
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource FaintBrush}"/>
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource FaintBrush}"/>
                                    </UniformGrid>
                                </Border>
                                <ContentPresenter Margin="26,12,14,12"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
                                <Setter TargetName="card" Property="Background" Value="{StaticResource RaisedBrush}"/>
                            </Trigger>
                            <Trigger SourceName="grip" Property="IsMouseOver" Value="True">
                                <Setter TargetName="grip" Property="Background" Value="{StaticResource SignalTintHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource SignalBorderBrush}"/>
                                <Setter TargetName="card" Property="Background" Value="{StaticResource SignalTintBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AccountTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar with online dot -->
                <Grid Width="48" Height="48">
                    <Ellipse Fill="{StaticResource Raised2Brush}"/>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SignalLightBrush}"/>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="dot" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"
                             Fill="{StaticResource FaintBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="3"
                             ToolTip="{Binding PresenceText}"/>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource DimBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="presence" Text="{Binding PresenceText}" Style="{StaticResource Crumb}"/>
                        <TextBlock Text="  ·  " Style="{StaticResource Crumb}"/>
                        <TextBlock Text="{Binding LastUsedText}" Style="{StaticResource Crumb}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource WarnBrush}"
                               TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource NotEmpty}}"/>
                </StackPanel>

                <CheckBox Grid.Column="2" Style="{StaticResource CheckSquare}" VerticalAlignment="Center" IsHitTestVisible="False"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource OkBrush}"/>
                    <Setter TargetName="presence" Property="Foreground" Value="{StaticResource OkBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Account list ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,20">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Bottom"
                        Tag="Add account|login new account">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11"/>
                        <TextBlock Text="Add account" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Click="Create_Click" VerticalAlignment="Bottom" Margin="0,0,8,0"
                        Tag="Create account|sign up register new roblox accounts list birthday gender">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FA;" Style="{StaticResource Icon}" FontSize="12"/>
                        <TextBlock Text="Create account" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="ORBIT / ACCOUNTS" Style="{StaticResource Crumb}"/>
                    <TextBlock Style="{StaticResource PageTitle}">
                        <Run Text="Your"/> <Run Text="accounts" Foreground="{StaticResource AccentTextBrush}"/>
                    </TextBlock>
                    <TextBlock x:Name="CountText" Text="0 accounts" Style="{StaticResource PageDesc}"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Clear" Margin="8,0,0,0" Click="SelectNone_Click"/>
                <Button DockPanel.Dock="Right" Content="Select all" Margin="8,0,0,0" Click="SelectAll_Click"/>
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browser_Click" Tag="Open browser|logged in website account"
                        ToolTip="Open roblox.com logged in as the selected account">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="12"/>
                        <TextBlock Text="Open browser" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBox x:Name="SearchBox" Tag="Filter accounts…" TextChanged="Search_TextChanged"/>
            </DockPanel>

            <Grid Grid.Row="2">
                <ListBox x:Name="AccountList" Background="Transparent" BorderThickness="0" SelectionMode="Multiple"
                         ItemContainerStyle="{StaticResource AccountItem}" ItemTemplate="{StaticResource AccountTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="0,0,6,0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>

                <!-- Drag & drop overlay: floating card + drop indicator -->
                <Canvas x:Name="DragLayer" IsHitTestVisible="False" ClipToBounds="True">
                    <Border x:Name="DropIndicator" Height="3" CornerRadius="1.5" Background="{StaticResource AccentTextBrush}" Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                    </Border>
                    <Border x:Name="DragGhost" Visibility="Collapsed" CornerRadius="10" Opacity="0.95"
                            BorderBrush="{StaticResource SignalBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.6"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <RotateTransform Angle="-1"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>

                <Border x:Name="EmptyState" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="32" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="No accounts yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                        <TextBlock Text="Add your first Roblox account. You log in on the real roblox.com page – Orbit only keeps the login, encrypted on this PC."
                                   Style="{StaticResource PageDesc}" TextAlignment="Center" MaxWidth="400"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                            <Button Style="{StaticResource SolidButton}" Content="Add account" Click="Add_Click"/>
                            <Button Content="Create a new one" Margin="8,0,0,0" Click="Create_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Join panel ================= -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="0,22,0,0">
            <Border Style="{StaticResource Panel}" Padding="20" Tag="Join game|server link place id private server share link job id launch follow user">
                <StackPanel>
                    <TextBlock Text="LAUNCH" Style="{StaticResource Crumb}" Foreground="{StaticResource SignalLightBrush}"/>
                    <TextBlock x:Name="PanelTitle" Text="Join a game" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>

                    <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="3" Margin="0,14,0,0">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="GameMode" Style="{StaticResource Segment}" Content="Join game" IsChecked="True" Checked="Mode_Changed"/>
                            <RadioButton x:Name="FollowMode" Style="{StaticResource Segment}" Content="Follow user" Checked="Mode_Changed"/>
                        </UniformGrid>
                    </Border>

                    <!-- Join game -->
                    <StackPanel x:Name="GamePanel">
                        <Border x:Name="GameCard" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,14,0,0">
                            <DockPanel>
                                <Grid Width="58" Height="58">
                                    <Border CornerRadius="8" Background="{StaticResource Raised2Brush}"/>
                                    <TextBlock x:Name="GameImageIcon" Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="20"
                                               HorizontalAlignment="Center" Foreground="{StaticResource FaintBrush}"/>
                                    <Border x:Name="GameImage" CornerRadius="8"/>
                                </Grid>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="GameName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="GameCreator" Style="{StaticResource RowDesc}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="GameMeta" Style="{StaticResource Crumb}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="PLACE ID OR GAME LINK" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                        <TextBox x:Name="PlaceBox" Tag="920587237 or roblox.com/games/…" TextChanged="Join_TextChanged"/>

                        <TextBlock Text="SERVER LINK (OPTIONAL)" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                        <TextBox x:Name="ServerBox" Tag="Private server / share link or Job ID" TextChanged="Join_TextChanged"/>
                    </StackPanel>

                    <!-- Follow user -->
                    <StackPanel x:Name="FollowPanel" Visibility="Collapsed">
                        <Border x:Name="UserCard" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,14,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <Grid Width="52" Height="52">
                                    <Ellipse Fill="{StaticResource Raised2Brush}"/>
                                    <Ellipse x:Name="UserImage"/>
                                    <Ellipse x:Name="UserDot" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Fill="{StaticResource FaintBrush}" Stroke="{StaticResource RaisedBrush}" StrokeThickness="3"/>
                                </Grid>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="UserHandle" Style="{StaticResource RowDesc}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="UserPresence" Style="{StaticResource Crumb}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="USERNAME" Style="{StaticResource Label}" Margin="0,14,0,6"/>
                        <TextBox x:Name="FollowBox" Tag="Username of the player to join" TextChanged="Follow_TextChanged"/>
                        <TextBlock Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                   Text="Joins the server the player is in. Works if their privacy settings allow others to join them."/>
                    </StackPanel>

                    <Button x:Name="LaunchButton" Style="{StaticResource SolidButton}" Height="44" Margin="0,20,0,0"
                            HorizontalAlignment="Stretch" Click="Launch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12"/>
                            <TextBlock x:Name="LaunchText" Text="Launch" Margin="10,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <ProgressBar x:Name="LaunchProgress" Margin="0,14,0,0" Maximum="100" Visibility="Collapsed"/>
                    <TextBlock x:Name="LaunchStatus" Style="{StaticResource RowDesc}" Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="HOW IT WORKS" Style="{StaticResource Crumb}"/>
                    <TextBlock Style="{StaticResource RowDesc}" Margin="0,8,0,0" LineHeight="20"
                               Text="1 · Click accounts on the left to select them.&#x0a;2 · Paste a game link – or follow a player.&#x0a;3 · Optional: paste a private server or share link.&#x0a;4 · Launch – several accounts start one after another."/>
                    <TextBlock Style="{StaticResource RowDesc}" Margin="0,10,0,0" Text="Drag the handle on the left of a card to reorder. Right-click for more options. Green dot = online."/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
