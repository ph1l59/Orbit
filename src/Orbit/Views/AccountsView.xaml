<UserControl x:Class="Orbit.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Orbit.Views">

    <UserControl.Resources>
        <local:UrlToImageConverter x:Key="UrlToImage"/>
        <local:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>

        <ContextMenu x:Key="AccountMenu">
            <MenuItem Header="Alias festlegen…" Click="Menu_Alias_Click"/>
            <MenuItem Header="Profil im Browser öffnen" Click="Menu_Profile_Click"/>
            <MenuItem Header="Login prüfen" Click="Menu_Check_Click"/>
            <MenuItem Header="Nach oben verschieben" Click="Menu_Up_Click"/>
            <MenuItem Header="Nach unten verschieben" Click="Menu_Down_Click"/>
            <MenuItem Header="Entfernen" Click="Menu_Remove_Click" Foreground="{StaticResource DangerBrush}"/>
        </ContextMenu>

        <Style x:Key="AccountItem" TargetType="ListBoxItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="ContextMenu" Value="{StaticResource AccountMenu}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                                <Setter TargetName="card" Property="Background" Value="{StaticResource Surface2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource AccentSolidBrush}"/>
                                <Setter TargetName="card" Property="Background" Value="#1A1730"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="AccountTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar -->
                <Grid Width="46" Height="46">
                    <Ellipse Fill="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <Ellipse>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl, Converter={StaticResource UrlToImage}}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Subtitle}" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Bottom"
                                   Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding LastUsedText}" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource SubTextBrush}"/>
                    <TextBlock Text="{Binding Status}" Margin="0,3,0,0" FontSize="12" Foreground="{StaticResource WarningBrush}"
                               TextWrapping="Wrap" Visibility="{Binding Status, Converter={StaticResource NotEmpty}}"/>
                </StackPanel>

                <!-- Check mark -->
                <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderHoverBrush}" BorderThickness="1.5" x:Name="check">
                    <TextBlock x:Name="checkIcon" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11"
                               HorizontalAlignment="Center" Foreground="White" Visibility="Collapsed"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="check" Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="check" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="checkIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Account list ================= -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Add_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Foreground="White"/>
                        <TextBlock Text="Account hinzufügen" Margin="8,0,0,0" Foreground="White"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Accounts" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="CountText" Text="0 Accounts" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Keine" Margin="8,0,0,0" Click="SelectNone_Click" ToolTip="Auswahl aufheben"/>
                <Button DockPanel.Dock="Right" Content="Alle auswählen" Margin="8,0,0,0" Click="SelectAll_Click"/>
                <TextBox x:Name="SearchBox" Tag="Suchen…" TextChanged="Search_TextChanged"/>
            </DockPanel>

            <Grid Grid.Row="2">
                <ListBox x:Name="AccountList" Background="Transparent" BorderThickness="0" SelectionMode="Multiple"
                         ItemContainerStyle="{StaticResource AccountItem}" ItemTemplate="{StaticResource AccountTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" Padding="0,0,6,0">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>

                <!-- Empty state -->
                <Border x:Name="EmptyState" Style="{StaticResource Card}" VerticalAlignment="Top" Padding="28" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SubTextBrush}"/>
                        <TextBlock Text="Noch keine Accounts" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="Füge deinen ersten Roblox-Account hinzu. Du meldest dich ganz normal auf roblox.com an – Orbit speichert danach nur das Login verschlüsselt auf diesem PC."
                                   Style="{StaticResource Sub}" TextAlignment="Center" MaxWidth="380"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Account hinzufügen" Margin="0,16,0,0"
                                HorizontalAlignment="Center" Click="Add_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= Join panel ================= -->
        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentSolidBrush}"/>
                        <TextBlock Text="Spiel beitreten" Style="{StaticResource H2}" Margin="10,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Place-ID oder Link" Style="{StaticResource Sub}" Margin="0,16,0,6"/>
                    <TextBox x:Name="PlaceBox" Tag="z. B. 920587237 oder roblox.com/games/…"/>

                    <TextBlock Text="Job-ID (optional, für einen bestimmten Server)" Style="{StaticResource Sub}" Margin="0,12,0,6"/>
                    <TextBox x:Name="JobBox" Tag="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"/>

                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0"
                               Text="Privatserver: einfach den kompletten Privatserver- oder Share-Link oben einfügen."/>

                    <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Height="44" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch" Click="Launch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Foreground="White"/>
                            <TextBlock x:Name="LaunchText" Text="Starten" Margin="10,0,0,0" FontSize="14" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="LaunchStatus" Style="{StaticResource Sub}" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="So funktioniert's" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                               Text="1. Accounts links anklicken, um sie auszuwählen.&#x0a;2. Spiel-Link oder Place-ID eintragen.&#x0a;3. Starten – bei mehreren Accounts wird nacheinander gestartet."/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                               Text="Rechtsklick auf einen Account für weitere Optionen."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
