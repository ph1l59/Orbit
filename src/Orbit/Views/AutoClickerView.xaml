<UserControl x:Class="Orbit.Views.AutoClickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Orbit.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="ORBIT / 07 / AUTO CLICKER" Style="{StaticResource Crumb}"/>
            <TextBlock Style="{StaticResource PageTitle}">
                <Run Text="Auto"/> <Run Text="clicker" Foreground="{StaticResource AccentTextBrush}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource PageDesc}" Text="A fast, precise auto clicker with a global hotkey – works while Roblox has focus. Some games don't allow macros, so check the rules."/>
        </StackPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,4" Padding="22,18">
            <DockPanel>
                <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource SolidButton}" Height="46" MinWidth="170"
                        VerticalAlignment="Center" Click="Start_Click">
                    <TextBlock x:Name="StartText" Text="Start" FontSize="14"/>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="54" Height="54" Margin="0,0,18,0">
                        <Ellipse x:Name="StateRing" Stroke="{StaticResource LineStrongBrush}" StrokeThickness="2"/>
                        <Ellipse x:Name="StateDot" Width="14" Height="14" Fill="{StaticResource FaintBrush}"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StateText" Text="STOPPED" Style="{StaticResource Crumb}"/>
                        <TextBlock x:Name="ClicksText" Text="0 clicks" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"/>
                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource RowDesc}" Text="Press F6 to start / stop"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <StackPanel>
                <TextBlock Text="// CLICKING" Style="{StaticResource Section}"/>

                <Border Style="{StaticResource Row}" Tag="Clicks per second|cps speed rate interval">
                    <DockPanel>
                        <local:NumberSlider x:Name="CpsSlider" DockPanel.Dock="Right" Minimum="1" Maximum="1000" Step="1" ValueChanged="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Clicks per second"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="1 to 1000. Type the exact number into the box for high values."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Mouse button|left right middle click">
                    <DockPanel>
                        <ComboBox x:Name="ButtonCombo" DockPanel.Dock="Right" SelectionChanged="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Mouse button"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Which button gets clicked."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Double click|click type">
                    <DockPanel>
                        <CheckBox x:Name="DoubleToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Double click"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Every click becomes a double click."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Click limit|stop after number of clicks repeat">
                    <DockPanel>
                        <TextBox x:Name="LimitBox" DockPanel.Dock="Right" Width="120" Style="{StaticResource NumberBox}"
                                 local:Numeric.IntegerOnly="True" LostKeyboardFocus="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Click limit"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Stop automatically after this many clicks. 0 = until you stop it."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="// HOTKEY" Style="{StaticResource Section}"/>

                <Border Style="{StaticResource Row}" Tag="Hotkey|shortcut key f6">
                    <DockPanel>
                        <ComboBox x:Name="HotkeyCombo" DockPanel.Dock="Right" SelectionChanged="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Hotkey"/>
                            <TextBlock x:Name="HotkeyDesc" Style="{StaticResource RowDesc}" Text="Works everywhere, also while Roblox is focused."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Hotkey mode|toggle hold">
                    <DockPanel>
                        <ComboBox x:Name="ModeCombo" DockPanel.Dock="Right" SelectionChanged="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Hotkey mode"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Toggle: press once to start, again to stop. Hold: clicks only while the key is held down."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="// WHERE" Style="{StaticResource Section}"/>

                <Border Style="{StaticResource Row}" Tag="Only click in Roblox|roblox window focus">
                    <DockPanel>
                        <CheckBox x:Name="RobloxOnlyToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Only click in Roblox"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Pauses automatically while another window is in front."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Fixed position|click location coordinates">
                    <DockPanel>
                        <CheckBox x:Name="FixedToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Changed" Margin="12,0,0,0"/>
                        <Button x:Name="PickButton" DockPanel.Dock="Right" Content="Pick position" Click="Pick_Click" VerticalAlignment="Center"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Fixed position"/>
                            <TextBlock x:Name="PositionText" Style="{StaticResource RowDesc}" Text="Always click at the same spot instead of where the mouse is."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
