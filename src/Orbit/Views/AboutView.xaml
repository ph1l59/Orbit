<UserControl x:Class="Orbit.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
            <TextBlock Text="ORBIT / ABOUT" Style="{StaticResource Crumb}"/>

            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/logo.png" Width="132" Height="132" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Margin="28,6,0,0">
                    <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="44" FontWeight="Bold">
                        <Run Text="Orbit"/><Run Text="." Foreground="{StaticResource SignalBrush}"/>
                    </TextBlock>
                    <TextBlock FontSize="17" Foreground="{StaticResource DimBrush}">
                        <Run Text="by"/> <Run Text="ph1l59" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Crumb}" Margin="0,10,0,0" Text="VERSION 2.0.0"/>
                    <TextBlock Style="{StaticResource PageDesc}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,14,0,0"
                               Text="Your Roblox launcher: manage accounts, run several clients at once, tune performance, add mods and an auto clicker – all in one app."/>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource SolidButton}" Click="GitHub_Click" Tag="GitHub|source code repository">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GitHub"/>
                                <TextBlock Text="  →"/>
                            </StackPanel>
                        </Button>
                        <Button Content="What's new" Margin="8,0,0,0" Click="WhatsNew_Click" Tag="What's new|changelog changes new features version"/>
                        <Button Content="Releases" Margin="8,0,0,0" Click="Releases_Click"/>
                        <Button Content="Report a bug" Margin="8,0,0,0" Click="Issues_Click" Tag="Report a bug|issue feedback"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="// UPDATES" Style="{StaticResource Section}" Margin="2,40,0,10"/>
            <Border Style="{StaticResource Row}" Tag="Check for updates|auto update new version release">
                <DockPanel>
                    <CheckBox x:Name="UpdatesToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Updates_Click"/>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Check for updates"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="When a new version of Orbit is out, a notice pops up in the bottom left. One click updates and restarts Orbit."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="// NOTIFICATIONS" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Row}" Tag="Disconnect notification|disconnected kicked lost connection error 277 alert">
                <DockPanel>
                    <CheckBox x:Name="DisconnectToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Disconnect_Click"/>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Tell me when a Roblox window disconnects"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="A notification with the account and the reason (e.g. error 277, kicked, server closed) when a window loses its game. Leaving or teleporting yourself doesn't count."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="// BACKGROUND" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Row}" Tag="Keep Orbit in the tray when closed|tray minimize background close">
                <DockPanel>
                    <CheckBox x:Name="TrayToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Tray_Click"/>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Keep Orbit in the tray when closed"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="Closing the window hides Orbit next to the clock, so friend notifications and updates keep working. Right-click the tray icon to quit."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Row}" Tag="Animated background|stars play page effects">
                <DockPanel>
                    <CheckBox x:Name="StarsToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Stars_Click"/>
                    <StackPanel Style="{StaticResource RowText}">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Animated background"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="An animated orbit around your avatar on the Play page, with stars and nebula that react to your mouse."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="// DATA" Style="{StaticResource Section}"/>
            <Button Style="{StaticResource LinkRow}" Click="Data_Click" Tag="Orbit data folder|settings accounts file">
                <DockPanel>
                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,16,0" Foreground="{StaticResource SignalLightBrush}"/>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="Open Orbit's data folder"/>
                        <TextBlock Style="{StaticResource RowDesc}" Text="Settings, mods and the encrypted account file. Never share accounts.dat with anyone."/>
                    </StackPanel>
                </DockPanel>
            </Button>

            <TextBlock Text="// LICENSE" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowDesc}" Margin="0"
                               Text="Orbit is open source under the GNU General Public License v3.0."/>
                    <TextBlock Style="{StaticResource RowDesc}"
                               Text="Inspired by Bloxstrap, Fishstrap and Roblox Account Manager. Orbit is not affiliated with, endorsed by or associated with Roblox Corporation."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
