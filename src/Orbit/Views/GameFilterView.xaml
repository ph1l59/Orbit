<UserControl x:Class="Orbit.Views.GameFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Orbit.Views">
    <UserControl.Resources>
        <Style x:Key="SliderLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Box" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="16,4,16,16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <!-- A section that opens and closes (like NVIDIA's filter panel) -->
        <Style x:Key="Section2" TargetType="Border" BasedOn="{StaticResource Panel}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="16,13">
                            <DockPanel>
                                <TextBlock x:Name="chevron" DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11"
                                           Foreground="{StaticResource DimBrush}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding Tag.Visibility, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static local:ChevronAngle.Instance}}"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13.5" TextElement.FontWeight="SemiBold"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="ORBIT / GAME FILTER" Style="{StaticResource Crumb}"/>
            <TextBlock Style="{StaticResource PageTitle}">
                <Run Text="Game"/> <Run Text="filter" Foreground="{StaticResource AccentTextBrush}"/>
            </TextBlock>
            <TextBlock Style="{StaticResource PageDesc}"
                       Text="Color filters for Roblox, like NVIDIA's game filters. Windows applies them to the picture on your screen – Roblox itself is never touched, so there's no risk for your accounts."/>
        </StackPanel>

        <!-- Left: preview and profiles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Padding="10">
                    <Grid x:Name="PreviewArea" ClipToBounds="True">
                        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Rectangle x:Name="PreviewVignette" IsHitTestVisible="False"/>
                        <Border x:Name="PreviewBarTop" Background="Black" VerticalAlignment="Top" Height="0"/>
                        <Border x:Name="PreviewBarBottom" Background="Black" VerticalAlignment="Bottom" Height="0"/>
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Padding="8,3" CornerRadius="6" Background="#99000000">
                            <TextBlock Text="PREVIEW" Style="{StaticResource Crumb}" Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Text="// PROFILES" Style="{StaticResource Section}"/>
                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3">
                    <WrapPanel x:Name="ProfileList"/>
                </Border>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="New" Margin="0,0,6,6" Click="New_Click" ToolTip="A new profile, starting from the one selected"/>
                    <Button Content="Rename" Margin="0,0,6,6" Click="Rename_Click"/>
                    <Button Content="Reset" Margin="0,0,6,6" Click="Reset_Click" ToolTip="Sets every slider of this profile back to 0"/>
                    <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,6,6" Click="Delete_Click"/>
                </WrapPanel>

                <Border Style="{StaticResource Row}" Margin="0,10,0,6" Tag="Preview on the whole screen|game filter test">
                    <DockPanel>
                        <CheckBox x:Name="ScreenPreviewToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="ScreenPreview_Click"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Preview on the whole screen"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Shows the filter right now, while you tune it. Turns itself off when you leave this page."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xE765;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,16,0" Foreground="{StaticResource SignalLightBrush}"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Hotkeys (also in game)"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Ctrl + Alt + F  turns the filter on or off  ·  Ctrl + Alt + G  switches to the next profile"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Row}" Tag="Game filter log|problem error vibrance enhanced not working">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Open log" Click="OpenLog_Click"/>
                        <StackPanel Style="{StaticResource RowText}">
                            <TextBlock Style="{StaticResource RowTitle}" Text="Something doesn't work?"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Orbit writes down what the filter, enhanced mode and digital vibrance did. Send this file when you report a problem."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Right: settings, in sections you open and close like NVIDIA's filter panel -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>
                <Border Style="{StaticResource Panel}" Padding="16,14" Margin="0,0,0,10" Tag="Game filter|nvidia filter color saturation enhanced">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox x:Name="EnabledToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Enabled_Click"/>
                            <TextBlock Text="Game filter" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource RowDesc}" Margin="0,6,0,0"
                                   Text="Turns on by itself whenever a Roblox window is in front."/>
                        <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,12,0,12"/>
                        <DockPanel>
                            <CheckBox x:Name="EnhancedToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Enhanced_Click"/>
                            <StackPanel>
                                <TextBlock Text="Enhanced mode" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Style="{StaticResource RowDesc}" Text="Orbit's own GPU filter: unlocks the settings marked ENHANCED. Adds about one frame of delay."/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="EnhancedStatus" Style="{StaticResource Crumb}" Margin="0,8,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Brightness / Contrast -->
                <Border Style="{StaticResource Section2}">
                    <StackPanel>
                        <Button Style="{StaticResource SectionHeader}" Content="Brightness / Contrast" Tag="{Binding ElementName=LightBody}" Click="Section_Click"/>
                        <StackPanel x:Name="LightBody" Margin="16,0,16,14">
                            <TextBlock Text="EXPOSURE" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="ExposureSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="BRIGHTNESS" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="CONTRAST" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <StackPanel x:Name="CurvesPanel">
                                <TextBlock Style="{StaticResource SliderLabel}"><Run Text="HIGHLIGHTS"/><Run Text="  ENHANCED" Foreground="{StaticResource SignalLightBrush}"/></TextBlock>
                                <local:NumberSlider x:Name="HighlightsSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                                <TextBlock Style="{StaticResource SliderLabel}"><Run Text="SHADOWS"/><Run Text="  ENHANCED" Foreground="{StaticResource SignalLightBrush}"/></TextBlock>
                                <local:NumberSlider x:Name="ShadowsSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                                <TextBlock Style="{StaticResource SliderLabel}"><Run Text="GAMMA"/><Run Text="  ENHANCED" Foreground="{StaticResource SignalLightBrush}"/></TextBlock>
                                <local:NumberSlider x:Name="GammaSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Color -->
                <Border Style="{StaticResource Section2}">
                    <StackPanel>
                        <Button Style="{StaticResource SectionHeader}" Content="Color" Tag="{Binding ElementName=ColorBody}" Click="Section_Click"/>
                        <StackPanel x:Name="ColorBody" Margin="16,0,16,14">
                            <TextBlock Text="TINT COLOR" Style="{StaticResource SliderLabel}"/>
                            <Border Height="6" CornerRadius="3" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF0000" Offset="0"/>
                                        <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                        <GradientStop Color="#00FF00" Offset="0.3333"/>
                                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                                        <GradientStop Color="#0000FF" Offset="0.6667"/>
                                        <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                        <GradientStop Color="#FF0000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <local:NumberSlider x:Name="TintHueSlider" Minimum="0" Maximum="360" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="TINT INTENSITY" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="TintSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="TEMPERATURE  ·  COLD ← → WARM" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="TemperatureSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="SATURATION" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="SaturationSlider" Minimum="-100" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <StackPanel x:Name="VibrancePanel">
                                <TextBlock Style="{StaticResource SliderLabel}"><Run Text="VIBRANCE"/><Run Text="  ENHANCED" Foreground="{StaticResource SignalLightBrush}"/></TextBlock>
                                <local:NumberSlider x:Name="VibranceSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Digital vibrance (NVIDIA) -->
                <Border Style="{StaticResource Section2}">
                    <StackPanel>
                        <Button Style="{StaticResource SectionHeader}" Content="Digital Vibrance (NVIDIA)" Tag="{Binding ElementName=DvcBody}" Click="Section_Click"/>
                        <StackPanel x:Name="DvcBody" Margin="16,0,16,14">
                            <TextBlock Text="LEVEL (%)  ·  50 = NORMAL  ·  0 = OFF" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="DvcSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock x:Name="DvcNote" Style="{StaticResource RowDesc}" Margin="0,8,0,0"
                                       Text="The same value as 'Digital vibrance' in the NVIDIA Control Panel. Set by the driver, costs no performance – only while Roblox is in front, your own setting comes back right after."/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Details -->
                <Border Style="{StaticResource Section2}">
                    <StackPanel>
                        <Button Style="{StaticResource SectionHeader}" Content="Details  ·  ENHANCED" Tag="{Binding ElementName=DetailsBody}" Click="Section_Click"/>
                        <StackPanel x:Name="DetailsBody" Margin="16,0,16,14">
                            <TextBlock Text="SHARPEN" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="SharpenSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="CLARITY" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="ClaritySlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="HDR TONING" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="HdrSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="BLOOM" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="BloomSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Look -->
                <Border Style="{StaticResource Section2}">
                    <StackPanel>
                        <Button Style="{StaticResource SectionHeader}" Content="Look" Tag="{Binding ElementName=LookBody}" Click="Section_Click"/>
                        <StackPanel x:Name="LookBody" Margin="16,0,16,14">
                            <TextBlock Text="STYLE" Style="{StaticResource SliderLabel}"/>
                            <ComboBox x:Name="LookBox" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="Changed">
                                <ComboBoxItem Content="None" Tag="none"/>
                                <ComboBoxItem Content="Black &amp; white" Tag="bw"/>
                                <ComboBoxItem Content="Sepia / old film" Tag="sepia"/>
                                <ComboBoxItem Content="Night mode (less blue)" Tag="night"/>
                                <ComboBoxItem Content="Color blind: red weakness" Tag="protan"/>
                                <ComboBoxItem Content="Color blind: green weakness" Tag="deutan"/>
                                <ComboBoxItem Content="Color blind: blue weakness" Tag="tritan"/>
                            </ComboBox>
                            <TextBlock Text="STRENGTH" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="LookSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Frame -->
                <Border Style="{StaticResource Section2}">
                    <StackPanel>
                        <Button Style="{StaticResource SectionHeader}" Content="Frame" Tag="{Binding ElementName=FrameBody}" Click="Section_Click"/>
                        <StackPanel x:Name="FrameBody" Margin="16,0,16,14">
                            <TextBlock Text="VIGNETTE  ·  DARK EDGES" Style="{StaticResource SliderLabel}"/>
                            <local:NumberSlider x:Name="VignetteSlider" Minimum="0" Maximum="100" Step="1" ValueChanged="Changed"/>
                            <TextBlock Text="LETTERBOX  ·  CINEMA BARS" Style="{StaticResource SliderLabel}"/>
                            <ComboBox x:Name="LetterboxBox" MinWidth="0" HorizontalAlignment="Stretch" SelectionChanged="Changed">
                                <ComboBoxItem Content="Off" Tag="none"/>
                                <ComboBoxItem Content="Wide (1.85 : 1)" Tag="1.85"/>
                                <ComboBoxItem Content="Cinema (2.39 : 1)" Tag="2.39"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
