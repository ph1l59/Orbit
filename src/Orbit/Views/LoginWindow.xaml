<Window x:Class="Orbit.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Orbit – Log in to Roblox" Width="520" Height="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="/Assets/orbit.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock x:Name="HeaderCrumb" Text="ORBIT // ADD ACCOUNT" Style="{StaticResource Crumb}" Foreground="{StaticResource SignalLightBrush}"/>
                <TextBlock x:Name="HeaderTitle" Text="Log in to Roblox" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource RowDesc}" Margin="0,4,0,0"
                           Text="Log in like you normally would. Orbit only keeps the login, encrypted on this PC – your password is never stored."/>
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
