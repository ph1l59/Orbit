<Window x:Class="Orbit.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Orbit – Bei Roblox anmelden" Width="520" Height="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Icon="/Assets/orbit.ico">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Bei Roblox anmelden" Style="{StaticResource H2}"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" Margin="0,4,0,0"
                           Text="Melde dich ganz normal an. Orbit speichert danach nur das Login verschlüsselt auf diesem PC – dein Passwort wird nicht gespeichert."/>
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Web"/>
    </DockPanel>
</Window>
