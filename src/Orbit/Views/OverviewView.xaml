<UserControl x:Class="Orbit.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
                <TextBlock Text="TILE SIZE" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Width="210">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="SizeSmall" Style="{StaticResource Segment}" Content="Small" GroupName="tileSize" Tag="small" Checked="Size_Checked"/>
                        <RadioButton x:Name="SizeMedium" Style="{StaticResource Segment}" Content="Medium" GroupName="tileSize" Tag="medium" Checked="Size_Checked"/>
                        <RadioButton x:Name="SizeLarge" Style="{StaticResource Segment}" Content="Large" GroupName="tileSize" Tag="large" Checked="Size_Checked"/>
                    </UniformGrid>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="ORBIT / OVERVIEW" Style="{StaticResource Crumb}"/>
                <TextBlock Style="{StaticResource PageTitle}">
                    <Run Text="Account"/> <Run Text="overview" Foreground="{StaticResource AccentTextBrush}"/>
                </TextBlock>
                <TextBlock x:Name="CountText" Style="{StaticResource PageDesc}" Text="All your Roblox windows live, on one screen."/>
            </StackPanel>
        </DockPanel>

        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Mini mode -->
            <Border Style="{StaticResource Panel}" Tag="Mini mode|small windows hide behind overview tiny">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="MiniToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Mini_Click" VerticalAlignment="Top"/>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Mini mode" FontSize="14.5" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="All Roblox windows as small as possible, tucked behind Orbit – you watch them here."/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="MiniStatus" Style="{StaticResource Crumb}" Margin="0,12,0,0" Text="OFF"/>
                </StackPanel>
            </Border>

            <!-- Resource saver -->
            <Border Grid.Column="2" Style="{StaticResource Panel}" Tag="Resource saver|cpu limit efficiency mode background windows performance">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="SaverToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Saver_Click" VerticalAlignment="Top"/>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Resource saver" FontSize="14.5" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Windows in the background use less CPU. The one you play in stays fast."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="CapBox" DockPanel.Dock="Right" Width="110" SelectionChanged="Cap_Changed">
                            <ComboBoxItem Content="No limit" Tag="0"/>
                            <ComboBoxItem Content="10 %" Tag="10"/>
                            <ComboBoxItem Content="25 %" Tag="25"/>
                            <ComboBoxItem Content="50 %" Tag="50"/>
                        </ComboBox>
                        <TextBlock Text="CPU LIMIT PER WINDOW" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <CheckBox x:Name="EcoToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Eco_Click"/>
                        <TextBlock Text="EFFICIENCY MODE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"
                                   ToolTip="Windows runs background Roblox windows on its power-saving cores"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Anti-AFK -->
            <Border Grid.Column="4" Style="{StaticResource Panel}" Tag="Anti-AFK|afk idle kick 20 minutes 267 key press">
                <StackPanel>
                    <DockPanel>
                        <CheckBox x:Name="AfkToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Click="Afk_Click" VerticalAlignment="Top"/>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Anti-AFK" FontSize="14.5" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource RowDesc}" Text="Presses Space in every window now and then, so Roblox doesn't kick you after 20 minutes."/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox x:Name="AfkInterval" DockPanel.Dock="Right" Width="110" SelectionChanged="AfkInterval_Changed">
                            <ComboBoxItem Content="5 min" Tag="5"/>
                            <ComboBoxItem Content="10 min" Tag="10"/>
                            <ComboBoxItem Content="15 min" Tag="15"/>
                        </ComboBox>
                        <TextBlock Text="EVERY" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <ComboBox x:Name="AfkMode" DockPanel.Dock="Right" Width="150" SelectionChanged="AfkMode_Changed">
                            <ComboBoxItem Content="In the background" Tag="background"
                                          ToolTip="Never moves your focus. Not every game counts it as activity."/>
                            <ComboBoxItem Content="Bring to front" Tag="focus"
                                          ToolTip="Each window comes to the front for a moment – only while you're away from mouse and keyboard. Works in every game."/>
                        </ComboBox>
                        <TextBlock Text="MODE" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Test" Height="28" Padding="12,0" Click="AfkTest_Click"/>
                        <TextBlock x:Name="AfkStatus" Style="{StaticResource Crumb}" VerticalAlignment="Center" Text="OFF"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Tiles -->
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="TileScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" ScrollChanged="Tiles_ScrollChanged">
                <WrapPanel x:Name="TilePanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <Border x:Name="EmptyState" Style="{StaticResource Panel}" VerticalAlignment="Top" Padding="32" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xECA5;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center" Foreground="{StaticResource SignalLightBrush}"/>
                    <TextBlock Text="No Roblox window open" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6"/>
                    <TextBlock Style="{StaticResource PageDesc}" TextAlignment="Center" MaxWidth="440"
                               Text="Launch your accounts from the Play or Accounts page – every Roblox window shows up here live."/>
                    <Button Style="{StaticResource SolidButton}" Content="Go to Accounts" HorizontalAlignment="Center" Margin="0,16,0,0" Click="GoAccounts_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
