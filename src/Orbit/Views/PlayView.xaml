<UserControl x:Class="Orbit.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Account picker (top right) -->
        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Height="56" CornerRadius="14" Padding="8,0,14,0"
                                Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SignalBorderBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Raised2Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerItem" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Height="52" CornerRadius="10" Padding="8,0,12,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SignalTintHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The big launch button -->
        <Style x:Key="LaunchButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="260"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">

                            <!-- glow -->
                            <Border x:Name="glow" CornerRadius="18" Background="#A855F7" Opacity="0.35" Margin="10,14,10,0">
                                <Border.Effect>
                                    <BlurEffect Radius="28"/>
                                </Border.Effect>
                            </Border>

                            <!-- body -->
                            <Border CornerRadius="18" BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#11FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <LinearGradientBrush x:Name="fill" StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#995B21B6" Offset="0"/>
                                        <GradientStop Color="#999333EA" Offset="0.55"/>
                                        <GradientStop Color="#99D946EF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!-- shine on the upper half -->
                            <Border CornerRadius="18,18,40,40" Margin="1,1,1,38" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- content: play icon + text -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="iconScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="iconShift" X="0"/>
                                        </TransformGroup>
                                    </Grid.RenderTransform>
                                    <Ellipse Fill="#2EFFFFFF" Stroke="#55FFFFFF" StrokeThickness="1"/>
                                    <Path Data="M 0,0 L 14,8 L 0,16 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="4,0,0,0" StrokeLineJoin="Round" Stroke="White" StrokeThickness="2"/>
                                </Grid>
                                <StackPanel Margin="16,0,6,0" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                    <StackPanel.RenderTransform>
                                        <ScaleTransform x:Name="textScale" ScaleX="1" ScaleY="1"/>
                                    </StackPanel.RenderTransform>
                                    <TextBlock Text="LAUNCH" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="Black"/>
                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" FontSize="12" Opacity="0.85" Margin="1,-2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="textScale" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="textScale" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="iconShift" Storyboard.TargetProperty="X" To="-4" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="textScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="textScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="iconScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="iconShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="root" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconRound" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource SignalBorderBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallAction" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title left, account picker right -->
        <DockPanel>
            <Grid DockPanel.Dock="Right" VerticalAlignment="Top">
                <Button x:Name="PickerButton" Style="{StaticResource PickerButton}" Click="Picker_Click" MinWidth="250"
                        Tag="Choose account|play account picker switch">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="11"
                                   VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource DimBrush}"/>
                        <Grid Width="38" Height="38">
                            <Ellipse Fill="{StaticResource Raised2Brush}"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="PickerAvatar" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Stroke="{StaticResource SignalBorderBrush}" StrokeThickness="1.5"/>
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PickerName" Text="No account" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                            <TextBlock x:Name="PickerUser" Text="Add one under Accounts" Style="{StaticResource Crumb}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                        </StackPanel>
                    </DockPanel>
                </Button>

                <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=PickerButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Margin="0,6,0,0" Padding="6" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1" CornerRadius="14" Width="{Binding ActualWidth, ElementName=PickerButton}" MaxHeight="440">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PickerList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PickerItem}" Click="PickAccount_Click" Tag="{Binding}">
                                            <DockPanel>
                                                <Grid Width="36" Height="36">
                                                    <Ellipse Fill="{StaticResource Raised2Brush}"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Crumb}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <Button x:Name="FriendsToggle" DockPanel.Dock="Right" Style="{StaticResource PickerButton}" Margin="0,0,10,0"
                    VerticalAlignment="Top" Click="FriendsToggle_Click" ToolTip="Show or hide friends"
                    Tag="Friends|friend list requests online join">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                    <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="16" VerticalAlignment="Center"
                               Foreground="{StaticResource SignalLightBrush}"/>
                    <TextBlock x:Name="FriendsToggleText" Text="Friends" FontWeight="SemiBold" FontSize="13.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border x:Name="RequestBadge" Background="#E879F9" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                            Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="RequestBadgeText" Text="0" FontSize="11" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Button>

            <StackPanel>
                <TextBlock Text="ORBIT / PLAY" Style="{StaticResource Crumb}"/>
                <TextBlock Style="{StaticResource PageTitle}">
                    <Run Text="Ready to"/> <Run Text="play" Foreground="{StaticResource AccentTextBrush}"/>
                </TextBlock>
                <TextBlock Text="Pick an account and launch Roblox." Style="{StaticResource PageDesc}"/>
            </StackPanel>
        </DockPanel>

        <!-- Stage: name tag, avatar, launch button -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Ellipse Width="440" Height="440" IsHitTestVisible="False" Opacity="0.55">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5B21B6" Offset="0"/>
                        <GradientStop Color="#2A1B47" Offset="0.45"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid x:Name="Stage" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border HorizontalAlignment="Center" Background="#CC0A090D" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="14,5,14,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource SignalLightBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NameTag" Text="—" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" LineStackingStrategy="BlockLineHeight" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Width="360" Height="360" Margin="0,6,0,0">
                    <!-- 2D picture: shown while the 3D model loads, or if it can't be loaded -->
                    <Image x:Name="AvatarImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- 3D avatar, turned by dragging with the mouse -->
                    <Viewport3D x:Name="AvatarView" Visibility="Collapsed" IsHitTestVisible="False">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="AvatarCamera" FieldOfView="30" UpDirection="0,1,0"/>
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#7A7A86"/>
                                    <DirectionalLight x:Name="KeyLight" Color="#F2F2F2" Direction="0,-0.5,1"/>
                                    <DirectionalLight x:Name="RimLight" Color="#6B46C1" Direction="0,0.2,-1"/>
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        <ModelVisual3D x:Name="AvatarVisual"/>
                    </Viewport3D>

                    <Border x:Name="DragSurface" Background="Transparent" Visibility="Collapsed" Cursor="Hand"
                            ToolTip="Drag to turn · double-click to reset"
                            MouseLeftButtonDown="Avatar_MouseDown" MouseMove="Avatar_MouseMove" MouseLeftButtonUp="Avatar_MouseUp"
                            LostMouseCapture="Avatar_LostCapture"/>

                    <TextBlock x:Name="AvatarHint" Text="Loading avatar…" Style="{StaticResource RowDesc}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button x:Name="LaunchButton" Style="{StaticResource LaunchButton}" Content="Roblox app" Click="Launch_Click"
                            Tag="Launch Roblox|play start app"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource RowDesc}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <!-- No accounts yet -->
            <Border x:Name="EmptyState" Style="{StaticResource Panel}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No accounts yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Add a Roblox account first, then you can launch it from here."
                               Style="{StaticResource PageDesc}" TextAlignment="Center" MaxWidth="360"/>
                    <Button Style="{StaticResource SolidButton}" Content="Go to Accounts" HorizontalAlignment="Center"
                            Margin="0,16,0,0" Click="GoToAccounts_Click"/>
                </StackPanel>
            </Border>

            <!-- ================= Friends panel ================= -->
            <Border x:Name="FriendsPanel" Grid.Column="1" Width="320" Margin="20,0,0,0" CornerRadius="14" Padding="14"
                    Background="#E6131119" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1">
                <DockPanel>
                    <!-- header -->
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconRound}" Click="FriendsToggle_Click" ToolTip="Hide"
                                Margin="6,0,0,0">
                            <TextBlock Text="&#xE8BB;" Style="{StaticResource Icon}" FontSize="10"/>
                        </Button>
                        <Button x:Name="FriendsRefresh" DockPanel.Dock="Right" Style="{StaticResource IconRound}" Click="FriendsRefresh_Click" ToolTip="Refresh">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12"/>
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="15" Foreground="{StaticResource SignalLightBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="FRIENDS" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- tabs -->
                    <Border DockPanel.Dock="Top" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="3" Margin="0,14,0,0">
                        <UniformGrid Columns="2">
                            <RadioButton x:Name="FriendsTab" Style="{StaticResource Segment}" IsChecked="True" Checked="Tab_Changed">
                                <TextBlock x:Name="FriendsTabText" Text="Friends"/>
                            </RadioButton>
                            <RadioButton x:Name="RequestsTab" Style="{StaticResource Segment}" Checked="Tab_Changed">
                                <TextBlock x:Name="RequestsTabText" Text="Requests"/>
                            </RadioButton>
                        </UniformGrid>
                    </Border>

                    <!-- search -->
                    <TextBox x:Name="FriendSearch" DockPanel.Dock="Top" Tag="Search friends…" Margin="0,10,0,0" TextChanged="FriendSearch_TextChanged"/>

                    <!-- footer -->
                    <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                        <Button Content="Add friend" Margin="0,0,4,0" Click="AddFriend_Click" ToolTip="Find people on roblox.com"/>
                        <Button Content="Chat" Margin="4,0,0,0" Click="Chat_Click" ToolTip="Open Roblox chat in the browser, logged in as this account"/>
                    </UniformGrid>

                    <TextBlock x:Name="FriendsStatus" DockPanel.Dock="Bottom" Style="{StaticResource RowDesc}" TextAlignment="Center" Margin="0,8,0,0"
                               Visibility="Collapsed"/>

                    <!-- list -->
                    <Grid Margin="0,10,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <ItemsControl x:Name="FriendsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PickerItem}" Tag="{Binding}" Click="Friend_Click" ToolTip="Open profile">
                                            <DockPanel>
                                                <!-- actions -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallAction}" Content="Join" Tag="{Binding}" Click="Join_Click"
                                                            Visibility="{Binding JoinVisibility}" ToolTip="Join this friend's server"/>
                                                    <Button Style="{StaticResource SmallAction}" Tag="{Binding}" Click="Accept_Click" Background="#16A34A"
                                                            Visibility="{Binding RequestVisibility}" ToolTip="Accept" Padding="0" Width="28">
                                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11"/>
                                                    </Button>
                                                    <Button Style="{StaticResource SmallAction}" Tag="{Binding}" Click="Decline_Click" Background="#3A2F4A"
                                                            Visibility="{Binding RequestVisibility}" ToolTip="Decline" Padding="0" Width="28" Margin="6,0,0,0">
                                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                                    </Button>
                                                </StackPanel>

                                                <!-- avatar with status dot -->
                                                <Grid Width="38" Height="38">
                                                    <Ellipse Fill="{StaticResource Raised2Brush}"/>
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarUrl, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                             Fill="{Binding StatusBrush}" Stroke="#131119" StrokeThickness="2.5"
                                                             Visibility="{Binding DotVisibility}"/>
                                                </Grid>

                                                <StackPanel Margin="11,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="11.5" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="FriendsEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Width="56" Height="56" CornerRadius="12" Background="{StaticResource SignalTintBrush}"
                                    BorderBrush="{StaticResource SignalBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="22" Foreground="{StaticResource SignalLightBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="FriendsEmptyTitle" Text="No friends yet" FontWeight="SemiBold" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,12,0,2"/>
                            <TextBlock x:Name="FriendsEmptyText" Text="ADD SOME!" Style="{StaticResource Crumb}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
