<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>Orbit</AssemblyName>
    <RootNamespace>Orbit</RootNamespace>
    <ApplicationIcon>Assets\orbit.ico</ApplicationIcon>
    <Product>Orbit</Product>
    <Company>Floshiii</Company>
    <Authors>Floshiii</Authors>
    <Copyright>Copyright (c) 2026 Floshiii</Copyright>
    <Description>Roblox account manager, multi-instance launcher and FPS/graphics tweaks in one app.</Description>
    <Version>3.2.1</Version>

    <!-- Single .exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en;de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Windows Forms is only used for the tray icon; keep its names out of the WPF code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\orbit.ico" />
    <Resource Include="Assets\roblox-window.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
